{
  "name": "my-learning-analytics",
  "type": "module",
  "version": "",
  "description": "Providing data visualization",
  "repository": "https://github.com/tl-its-umich-edu/my-learning-analytics",
  "license": "Apache-2.0",
  "dependencies": {
    "@apollo/client": "4.3.6",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0",
    "@mui/utils": "5.17.1",
    "clsx": "2.1.1",
    "d3": "7.9.2",
    "d3-v6-tip": "1.0.9",
    "graphql": "17.1.0",
    "js-cookie": "3.0.8",
    "lodash.debounce": "4.0.8",
    "rc-slider": "11.1.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "rxjs": "7.8.2"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ]
  },
  "scripts": {
    "prod": "BABEL_ENV=production webpack --config webpack.config.js --mode production",
    "build": "BABEL_ENV=development webpack --config webpack.config.js --mode development",
    "watch": "BABEL_ENV=development webpack --config webpack.config.js --watch --mode development",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "update-snapshot": "jest --updateSnapshot"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testMatch": [
      "<rootDir>/assets/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/assets/src/**/?(*.)(spec|test).{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "globals": {
      "IS_REACT_ACT_ENVIRONMENT": true
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/assets/config/jest/cssTransform.cjs",
      "^(?!.*\\.(js|cjs|jsx|ts|tsx|css|json)$)": "<rootDir>/assets/config/jest/fileTransform.cjs"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^d3$": "<rootDir>/node_modules/d3/dist/d3.min.js",
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "testPathIgnorePatterns": [
      "testData"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "react-app-polyfill": "3.0.0",
    "react-test-renderer": "19.3.1",
    "standard": "17.1.2",
    "style-loader": "4.0.0",
    "url-loader": "4.1.1",
    "webpack": "5.112.2",
    "webpack-bundle-tracker": "3.2.4",
    "webpack-cli": "7.3.1"
  }
}